# Copy to .env for local runs. NEVER commit .env — it holds your webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
# Google Sheets link (shared "Anyone with the link can view"), a link to an .xlsx/.csv, or a local path
TIMELINE_SOURCE=examples/sample_timeline.xlsx

# Optional: AI-written digest from Claude (falls back to a plain list if unset)
ANTHROPIC_API_KEY=

# Optional tuning
PROJECT_NAME=
TIMEZONE=America/New_York
LOOKAHEAD_DAYS=14
OVERDUE_DAYS=30
SKIP_IF_EMPTY=false
DAY_FIRST=false
SHEET_NAME=
BOT_NAME=Timeline Bot
# Column overrides if auto-detection picks the wrong header
NAME_COLUMN=
DATE_COLUMN=
END_COLUMN=
STATUS_COLUMN=
OWNER_COLUMN=
CATEGORY_COLUMN=
NOTES_COLUMN=
