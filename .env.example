# Copy to .env for local runs. NEVER commit .env — it holds your webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
# Google Sheets link (shared "Anyone with the link can view"), a link to an .xlsx/.csv, or a local path
TIMELINE_SOURCE=examples/sample_timeline.xlsx

# Who writes the digest (falls back to the code-only list if the AI call fails):
#   none   = code only, no AI
#   github = GitHub Models, free (needs GITHUB_TOKEN: a PAT with "Models: read")
#   gemini = Google Gemini free tier (GEMINI_API_KEY from aistudio.google.com)
#   groq   = Groq free tier (GROQ_API_KEY from console.groq.com)
#   ollama = local model on your machine (install Ollama, run `ollama pull llama3.2`)
#   openai = any OpenAI-compatible endpoint (set AI_BASE_URL, AI_API_KEY, AI_MODEL)
#   claude = Anthropic Claude, paid (ANTHROPIC_API_KEY)
#   auto   = Claude if its key is set, else Gemini/Groq if a key is set, else none
AI_PROVIDER=none
AI_MODEL=
GITHUB_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional tuning
PROJECT_NAME=
TIMEZONE=America/New_York
LOOKAHEAD_DAYS=14
OVERDUE_DAYS=30
SKIP_IF_EMPTY=false
DAY_FIRST=false
SHEET_NAME=
BOT_NAME=Timeline Bot
# Column overrides if auto-detection picks the wrong header
NAME_COLUMN=
DATE_COLUMN=
END_COLUMN=
STATUS_COLUMN=
OWNER_COLUMN=
CATEGORY_COLUMN=
NOTES_COLUMN=
